{
  "name": "hello-athena",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev-with-sync": "concurrently \"next dev -p 3000\" \"node watch-excel.js\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "ts-node prisma/seed.ts",
    "electron-dev": "concurrently \"next dev -p 3000\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "next build && electron-builder",
    "dist": "npm run build && electron-builder -p always",
    "watch-excel": "node watch-excel.js",
    "sync-db": "node sync-database.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "date-fns": "^4.1.0",
    "electron-is-dev": "^3.0.1",
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.4",
    "next": "16.2.6",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.helloathena.pos",
    "productName": "Hello Athena",
    "asar": false,
    "forceCodeSigning": false,
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      ".next/standalone/**",
      ".next/static/**",
      "public/**",
      "prisma/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "sign": false
    }
  }
}
