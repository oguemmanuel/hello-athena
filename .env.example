# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Password for the in-app Admin/POS unlock screen.
# NOTE: this is a NEXT_PUBLIC_ var, so it is embedded in the browser bundle at
# build time. It keeps the value out of source control but is not real security —
# for that, move admin auth to the server.
NEXT_PUBLIC_ADMIN_PASSWORD=changeme
